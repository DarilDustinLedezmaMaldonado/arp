# =============================================================================
# Aerolineas Rafael Pabon - variables de entorno
# Copia este archivo a ".env" (uno por PC si haces la demo en 3 maquinas) y
# ajusta segun corresponda. Para LAN las claves siguientes son obligatorias.
# npm run local:all usa una excepción sin claves, solo en loopback con SQLite.
# =============================================================================

# ---- Identidad de este proceso/nodo ----
# Uno de: NODE_NA | NODE_EA | NODE_SA (ver config/nodes.json)
NODE_ID=NODE_NA
PORT=4001
BIND_HOST=0.0.0.0
# Genera cada clave por separado: openssl rand -hex 32
# SYNC_SECRET debe ser la misma en las tres PC. ADMIN_SECRET debe ser distinta de
# SYNC_SECRET; usa la misma ADMIN_SECRET en las tres PC para que Administracion
# (pasajes recientes, interruptores de falla) pueda consultar los tres nodos.
SYNC_SECRET=
ADMIN_SECRET=
ALLOW_INSECURE_LOCAL=false

# ---- Motor de base de datos primaria de ESTE nodo ----
# sqlite (por defecto si no defines nada = modo demo en 1 PC, cero instalacion)
# mssql  (NODE_NA y NODE_EA en la entrega real)
# mongo  (NODE_SA en la entrega real)
DB_DRIVER=sqlite

# ---- SQL Server (si DB_DRIVER=mssql) ----
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=arp_NODE_NA
MSSQL_USER=sa
MSSQL_PASSWORD=CambiaEstaClave123!
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# Si una sola PC de administracion debe sembrar ambos SQL Server remotos,
# estas variables especificas por nodo tienen prioridad sobre las anteriores:
# NODE_NA_MSSQL_SERVER=192.168.1.10
# NODE_NA_MSSQL_DATABASE=arp_NODE_NA
# NODE_NA_MSSQL_USER=sa
# NODE_NA_MSSQL_PASSWORD=clave
# NODE_EA_MSSQL_SERVER=192.168.1.11
# NODE_EA_MSSQL_DATABASE=arp_NODE_EA
# NODE_EA_MSSQL_USER=sa
# NODE_EA_MSSQL_PASSWORD=clave

# ---- MongoDB (si DB_DRIVER=mongo, tipicamente solo en NODE_SA) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=arp_NODE_SA
# Variables especificas opcionales: NODE_SA_MONGO_URI y NODE_SA_MONGO_DB

# ---- Direcciones de los otros nodos (para la demo en LAN de 3 PC) ----
# Si no defines nada, se usan los host/port de config/nodes.json (localhost:400x,
# pensado para probar los 3 nodos en 1 sola PC). Para la LAN real declara las
# TRES IP en las tres PC (tambien la propia): el navegador recibe estas URL para
# hablar con cada nodo, y "localhost" no sirve desde otra computadora.
# NODE_NA_HOST=192.168.1.10
# NODE_NA_PORT=4001
# NODE_EA_HOST=192.168.1.11
# NODE_EA_PORT=4002
# NODE_SA_HOST=192.168.1.12
# NODE_SA_PORT=4003

# ---- Fecha "de hoy" simulada para el seed (regla de vuelos futuros -> SCHEDULED) ----
SIM_TODAY=2026-09-26

# ---- Apple Wallet (.pkpass real, firmado) - OPCIONAL ----
# Sin estas variables, el sistema sigue funcionando normalmente (PDF + pase
# digital web + QR); solo el boton de ".pkpass firmado" queda deshabilitado.
# Requiere una cuenta de Apple Developer. Ver README, seccion "Wallet".
# PKPASS_WWDR=./certs/wwdr.pem
# PKPASS_SIGNER_CERT=./certs/signerCert.pem
# PKPASS_SIGNER_KEY=./certs/signerKey.pem
# PKPASS_SIGNER_KEY_PASSPHRASE=
# PKPASS_PASS_TYPE_ID=pass.com.rafaelpabon.boarding
# PKPASS_TEAM_ID=XXXXXXXXXX

# ---- Google Wallet (pase genérico, configuración única) - OPCIONAL ----
# 1. Crea un emisor en Google Wallet Business Console.
# 2. Autoriza una cuenta de servicio y guarda su JSON fuera del repositorio.
# Guarda el JSON como secrets/google-wallet-service-account.json. Con ese nombre
# solo hace falta definir el ID; clase y objetos se crean al guardar.
# GOOGLE_WALLET_ISSUER_ID=3388000000022XXXXXX
# GOOGLE_WALLET_CREDENTIALS=./otra/ruta/opcional.json
